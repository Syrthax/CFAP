{
  "buildCommand": "npm run build --workspace=web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/chat.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/advise", "destination": "/api/advise" },
    { "source": "/chat", "destination": "/api/chat" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
